{
  "name": "asf-stm-enhancement",
  "version": "1.0.1",
  "private": true,
  "description": "ASF STM Enhancement userscript: ASF bot list trade matcher for Steam Community badges",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "node --import @oxc-node/core/register scripts/build.ts",
    "test": "node --import @oxc-node/core/register ./node_modules/vitest/vitest.mjs run",
    "lint": "oxlint",
    "format": "oxfmt src/lib test scripts",
    "format:check": "oxfmt --check src/lib test scripts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@oxc-node/cli": "0.1.3",
    "@oxc-node/core": "0.1.3",
    "@types/node": "^26.6.2",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
